# Browser-safe (these end up in the JS bundle)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — never commit. Get from Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server-only — Postgres connection string for Drizzle migrations.
# Get from Supabase → Settings → Database → Connection string → URI.
# Use the "Pooler" / "Connection pooling" URL with mode=session for migrations,
# or mode=transaction for runtime queries. Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ─── Notifications / cron (Web Push + IndexPulse alerts) ───
# Web Push VAPID keypair. Generate once: `npx web-push generate-vapid-keys`.
# Public key is also exposed to the browser as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:hello@easysplits.in

# Shared secret protecting the cron routes (/api/cron/*). Cron callers
# must send `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ─── IndexPulse (admin-only index-fund / ETF alerts) ───
# Comma-separated Supabase user UUIDs allowed into /app/admin AND
# /app/indexpulse. Empty = nobody is admin (safe default).
ADMIN_USER_IDS=

# Email alert delivery via Resend (free tier). Optional — email alerts
# no-op without it. Get a key at resend.com.
RESEND_API_KEY=
# From address for alert emails (must be a Resend-verified domain).
INDEXPULSE_EMAIL_FROM=IndexPulse <alerts@easysplits.in>
# Fallback recipient when the cron can't resolve a user's auth email
# (i.e. SUPABASE_SERVICE_ROLE_KEY not set). Optional.
INDEXPULSE_ALERT_EMAIL=
